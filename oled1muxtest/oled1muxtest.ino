// B-CH2 — Heart animation (top-left, FLIPPED): 48x48 centered, cycling frames
static void drawB_Ch2() {
    disp2.clearDisplay();
    // Heart is 48x48; the blue zone on the flipped display is y=0..47 (exactly 48px).
    // Centering vertically would extend into the yellow hardware strip, so anchor to y=0.
    disp2.drawBitmap(
        (SCREEN_WIDTH - HEART_W) / 2,
        0,
        heartFrames[heartFrame], HEART_W, HEART_H, SSD1306_WHITE);
    disp2.display();
}

// B-CH0 — Uptime (top-right, FLIPPED): HH:MM:SS large, "UPTIME" in yellow bar
static void drawB_Ch0() {
    disp0.clearDisplay();
    disp0.setTextColor(SSD1306_WHITE);
    unsigned long s = millis() / 1000;
    unsigned long d = s / 86400; s %= 86400;
    unsigned long h = s / 3600;  s %= 3600;
    unsigned long m = s / 60;    s %= 60;
    if (d > 0) {
        char dstr[8];  snprintf(dstr,  sizeof(dstr),  "%lud",        d);
        char tstr[10]; snprintf(tstr,  sizeof(tstr),  "%02lu:%02lu:%02lu", h, m, s);
        centerText(disp0, dstr,  6, 2);
        centerText(disp0, tstr, 24, 2);
    } else {
        char tstr[10]; snprintf(tstr, sizeof(tstr), "%02lu:%02lu:%02lu", h, m, s);
        centerText(disp0, tstr, 14, 2);
    }
    disp0.drawFastHLine(0, YBAR_BOT_Y - 1, SCREEN_WIDTH, SSD1306_WHITE);
    centerText(disp0, "UPTIME", YBAR_BOT_Y + 2, 1);
    disp0.display();
}

// B-CH3 — Battery health (bot-left, normal): charge rate in yellow bar, status + % below
static void drawB_Ch3() {
    disp3.clearDisplay();
    disp3.setTextColor(SSD1306_WHITE);
    if (batteryOK) {
        float rate = maxlipo.chargeRate();
        char rstr[14];
        if (!isnan(rate)) snprintf(rstr, sizeof(rstr), "%+.1f%%/hr", rate);
        else              strncpy(rstr, "---", sizeof(rstr));
        centerText(disp3, rstr, 3, 1);
    } else {
        centerText(disp3, "No gauge", 3, 1);
    }
    disp3.drawFastHLine(0, 15, SCREEN_WIDTH, SSD1306_WHITE);
    if (!batteryOK || batteryPct < 0) {
        centerText(disp3, "Reading...", 34, 1);
    } else {
        float rate = maxlipo.chargeRate();
        const char* status = (!isnan(rate) && rate >  0.5f) ? "CHARGING"    :
                             (!isnan(rate) && rate < -0.5f) ? "DISCHARGING" : "IDLE";
        centerText(disp3, status, 18, 1);
        char pstr[6]; snprintf(pstr, sizeof(pstr), "%d%%", batteryPct);
        centerText(disp3, pstr, 26, 3);
        if (batteryV > 0) {
            char vstr[10]; snprintf(vstr, sizeof(vstr), "%.3fV", batteryV);
            centerText(disp3, vstr, 55, 1);
        }
    }
    disp3.display();
}

// B-CH1 — Greeting (bot-right, normal)
static void drawB_Ch1() {
    disp1.clearDisplay();
    disp1.setTextColor(SSD1306_WHITE);
