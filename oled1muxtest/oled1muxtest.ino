// ─── TCA helpers ──────────────────────────────────────────────────────────────

static void tcaSelect(uint8_t ch) {
    Wire.beginTransmission(TCA_ADDR);
    Wire.write((ch < 8) ? (1 << ch) : 0x00);
    Wire.endTransmission();
}
static void tcaDisable() {
    Wire.beginTransmission(TCA_ADDR);
    Wire.write(0x00);
    Wire.endTransmission();
}
static bool i2cProbe(uint8_t addr) {
    Wire.beginTransmission(addr);
    return (Wire.endTransmission() == 0);
}

// ─── draw helpers ─────────────────────────────────────────────────────────────

static void centerText(Adafruit_SSD1306& d, const char* t, int y, int s) {
    int16_t x1, y1; uint16_t w, h;
    d.setTextSize(s);
    d.getTextBounds(t, 0, y, &x1, &y1, &w, &h);
    d.setCursor((SCREEN_WIDTH - (int)w) / 2, y);
    d.print(t);
}

// decorative accent line styles
static void accentTicker(Adafruit_SSD1306& d, int y) {
    // base dotted line
    for (int x = 0; x < SCREEN_WIDTH; x += 4)
        d.drawPixel(x, y, SSD1306_WHITE);
    // moving bright pixel
    int pos = (millis() / 20) % SCREEN_WIDTH;
    d.drawPixel(pos, y, SSD1306_WHITE);
    d.drawPixel((pos + 1) % SCREEN_WIDTH, y, SSD1306_WHITE);
    d.drawPixel((pos - 1 + SCREEN_WIDTH) % SCREEN_WIDTH, y, SSD1306_WHITE);
}
static void accentWave(Adafruit_SSD1306& d, int y) {
    // scrolling sine-ish wave
    static const int8_t wv[8] = {0,0,1,1,1,1,0,0};
    int phase = (millis() / 35) % 8;
    for (int x = 0; x < SCREEN_WIDTH; x++)
        d.drawPixel(x, y + wv[(x + phase) % 8], SSD1306_WHITE);
}
static void accentComet(Adafruit_SSD1306& d, int y) {
    // ping-pong comet with trail
    uint32_t t   = millis() % 2000;
    int head = (t < 1000) ? (t * (SCREEN_WIDTH - 1)) / 1000
                           : ((2000 - t) * (SCREEN_WIDTH - 1)) / 1000;
    int dir  = (t < 1000) ? 1 : -1;
    for (int i = 0; i < 5; i++) {
        int px = head - dir * i;
        if (px >= 0 && px < SCREEN_WIDTH) d.drawPixel(px, y, SSD1306_WHITE);
    }
    for (int i = 5; i < 13; i += 2) {
        int px = head - dir * i;
        if (px >= 0 && px < SCREEN_WIDTH) d.drawPixel(px, y, SSD1306_WHITE);
    }
}

static void accentDash(Adafruit_SSD1306& d, int y) {
    for (int x = 0; x < SCREEN_WIDTH; x++)
        if ((x % 5) < 3) d.drawPixel(x, y, SSD1306_WHITE);
}

static void battIcon(Adafruit_SSD1306& d, int x, int y, int w, int h, int pct) {
    d.drawRect(x, y, w, h, SSD1306_WHITE);
    int th = h / 2, ty = y + (h - th) / 2;
    d.fillRect(x + w, ty, 2, th, SSD1306_WHITE);
    if (pct >= 0) {
        int fw = ((w - 4) * constrain(pct, 0, 100)) / 100;
        if (fw > 0) d.fillRect(x + 2, y + 2, fw, h - 4, SSD1306_WHITE);
    }
}

// --- per-screen draw functions ---

// ======================== SET A - clock ========================
// CH0 - Minutes (top-right, FLIPPED)
static void drawCh0() {
    disp0.clearDisplay();
    disp0.setTextColor(SSD1306_WHITE);
    if (!timeReady) {
        centerText(disp0, "--", 0, 6);
    } else {
        struct tm ti;
        if (getLocalTime(&ti, 20)) {
            char mn[4]; snprintf(mn, sizeof(mn), "%02d", ti.tm_min);
            centerText(disp0, mn, 0, 6);
            char ss[4]; snprintf(ss, sizeof(ss), "%02d", ti.tm_sec);
            disp0.setTextSize(1);
            disp0.setCursor(116, 48);
            disp0.print(ss);
        }
    }
    disp0.display();
}

// CH1 - Date dd/mm/yy (bot-right, normal)
static void drawCh1() {
    disp1.clearDisplay();
    disp1.setTextColor(SSD1306_WHITE);
    if (!timeReady) {
        centerText(disp1, "--/--/--", 24, 2);
    } else {
        struct tm ti;
        if (getLocalTime(&ti, 20)) {
            char dt[12]; strftime(dt, sizeof(dt), "%m/%d/%Y", &ti);
            centerText(disp1, dt, 24, 2);
        }
    }
    disp1.display();
}

// CH2 - Hours (top-left, FLIPPED)
static void drawCh2() {
    disp2.clearDisplay();
    disp2.setTextColor(SSD1306_WHITE);
    if (!timeReady) {
        centerText(disp2, "--", 0, 6);
    } else {
        struct tm ti;
        if (getLocalTime(&ti, 20)) {
            int h = ti.tm_hour % 12;
            if (h == 0) h = 12;
            char hr[4]; snprintf(hr, sizeof(hr), "%d", h);
            centerText(disp2, hr, 0, 6);
        }
    }
    disp2.display();
}

// CH3 - Day of week (bot-left, normal)
static void drawCh3() {
    disp3.clearDisplay();
    disp3.setTextColor(SSD1306_WHITE);
    if (!timeReady) {
        centerText(disp3, "---", 24, 2);
    } else {
        struct tm ti;
        if (getLocalTime(&ti, 20)) {
            char day[12]; strftime(day, sizeof(day), "%A", &ti);
            centerText(disp3, day, 24, 2);
        }
    }
    disp3.display();
}

