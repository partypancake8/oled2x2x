// ======================== SET C - info / links ========================
// C-CH0 - S&P 500 (top-right, FLIPPED)
static void drawC_Ch0() {
    disp0.clearDisplay();
    disp0.setTextColor(SSD1306_WHITE);
    centerText(disp0, "SPX", 2, 1);
    if (!spxHasData) {
        centerText(disp0, wifiConnected ? "fetching..." : "no wifi", 28, 1);
    } else {
        char pstr[14]; snprintf(pstr, sizeof(pstr), "$%.2f", spxPrice);
        centerText(disp0, pstr, 12, 2);
        char cstr[22];
        float adol = fabsf(spxChangeDollar);
        float apct = fabsf(spxChangePct);
        if (spxChangePct >= 0) snprintf(cstr, sizeof(cstr), "^ +$%.2f +%.2f%%", adol, apct);
        else                   snprintf(cstr, sizeof(cstr), "v -$%.2f -%.2f%%", adol, apct);
        centerText(disp0, cstr, 31, 1);
        if (spxFetchTime > 0 && timeReady) {
            struct tm ti; localtime_r(&spxFetchTime, &ti);
            char tstr[14]; snprintf(tstr, sizeof(tstr), "@ %02d:%02d", ti.tm_hour, ti.tm_min);
            centerText(disp0, tstr, 40, 1);
        }
    }
    accentWave(disp0, 52);
    disp0.display();
}

// C-CH1 - Personal site (bot-right, normal)
static void drawC_Ch1() {
    disp1.clearDisplay();
    disp1.setTextColor(SSD1306_WHITE);
    // yellow band (y=0..15): wifi status
    if (wifiConnected) {
        String ssid = WiFi.SSID();
        if (ssid.length() > 12) ssid = ssid.substring(0, 12);
        centerText(disp1, ssid.c_str(), 0, 1);
        centerText(disp1, WiFi.localIP().toString().c_str(), 8, 1);
    } else {
        centerText(disp1, "no wifi", 4, 1);
    }
    centerText(disp1, "swyr.com", 22, 2);
    disp1.display();
}

// C-CH2 - Battery discharge (top-left, FLIPPED)
static void drawC_Ch2() {
    disp2.clearDisplay();
    disp2.setTextColor(SSD1306_WHITE);
    centerText(disp2, "BATTERY", 2, 1);
    accentDash(disp2, 11);
    if (!batteryOK) {
        centerText(disp2, "no gauge", 30, 1);
    } else {
        float rate = maxlipo.chargeRate();
        const char* status = (!isnan(rate) && rate >  0.5f) ? "CHARGING" :
                             (!isnan(rate) && rate < -0.5f) ? "DRAINING" : "IDLE";
        centerText(disp2, status, 14, 2);
        if (!isnan(rate)) {
            char rstr[14]; snprintf(rstr, sizeof(rstr), "%+.1f%%/hr", rate);
            centerText(disp2, rstr, 31, 1);
        }
        if (batteryV > 0) {
            char vstr[10]; snprintf(vstr, sizeof(vstr), "%.3fV", batteryV);
            centerText(disp2, vstr, 40, 1);
        }
    }
    accentComet(disp2, 52);
    disp2.display();
}

// C-CH3 - Sawyer made this (bot-left, normal)
static void drawC_Ch3() {
    disp3.clearDisplay();
    disp3.setTextColor(SSD1306_WHITE);
    // animated comet in yellow band
    accentTicker(disp3, 7);
    centerText(disp3, "sawyer", 16, 2);
    centerText(disp3, "made this", 34, 2);
    centerText(disp3, ":)", 52, 1);
    disp3.display();
}

// ─── sensor / network helpers ─────────────────────────────────────────────────

static void refreshSPX() {
    if (!wifiConnected) return;
    WiFiClientSecure client;
    client.setInsecure();
    HTTPClient http;
    // v8 chart API: returns JSON with regularMarketPrice near the start (<1KB in)
    http.begin(client, "https://query2.finance.yahoo.com/v8/finance/chart/%5EGSPC?range=1d&interval=1d");
    http.setTimeout(10000);
    http.addHeader("User-Agent", "Mozilla/5.0 (compatible)");
    http.addHeader("Accept", "application/json");
    int code = http.GET();
    if (code == HTTP_CODE_OK) {
        static char buf[2048];
        WiFiClient* s = http.getStreamPtr();
        int n = s->readBytes(buf, sizeof(buf) - 1);
        buf[n] = '\0';
        char* pos = strstr(buf, "\"regularMarketPrice\":");
        char* pos4 = strstr(buf, "\"chartPreviousClose\":");
        float prev = 0.0f;
        if (pos4) { char* c4 = strchr(pos4, ':'); if (c4) prev = atof(c4 + 1); }
        if (pos) {
            char* colon = strchr(pos, ':');
            float p = colon ? atof(colon + 1) : 0.0f;
            if (p > 100.0f) {
                spxPrice   = p;
                spxHasData = true;
                time(&spxFetchTime);
                // calculate change from previous close
                if (prev > 100.0f) {
                    spxChangeDollar = spxPrice - prev;
                    spxChangePct    = (spxChangeDollar / prev) * 100.0f;
                }
                // also try explicit change fields if present
                char* pos2 = strstr(buf, "\"regularMarketChangePercent\":");
                if (pos2) { char* c2 = strchr(pos2, ':'); if (c2) spxChangePct = atof(c2 + 1); }
                char* pos3 = strstr(buf, "\"regularMarketChange\":");
                if (pos3) { char* c3 = strchr(pos3, ':'); if (c3) spxChangeDollar = atof(c3 + 1); }
                Preferences prefs; prefs.begin("spx", false);
                prefs.putFloat("price", spxPrice);
                prefs.putFloat("chpct", spxChangePct);
                prefs.putFloat("chdol", spxChangeDollar);
                prefs.putLong64("ftime", (long long)spxFetchTime);
                prefs.end();
            }
        }
    }
    http.end();
}

static void refreshBattery() {
    if (!batteryOK) return;
    float p = maxlipo.cellPercent();
    float v = maxlipo.cellVoltage();
    batteryPct = isnan(p) ? -1 : constrain((int)(p + 0.5f), 0, 100);
    batteryV   = isnan(v) ? -1.0f : v;
}

static void refreshSensor() {
    if (!sht4OK) return;
    sensors_event_t hum, temp;
    if (sht4.getEvent(&hum, &temp)) {
        lastTempF    = temp.temperature * 9.0f / 5.0f + 32.0f + TEMP_OFFSET_F;
        lastHumidity = hum.relative_humidity;
    }
}

static void tryWifi() {
    if (wifiConnected) return;
    WiFi.disconnect(true);
    delay(100);
    WiFi.mode(WIFI_STA);
    WiFi.setAutoReconnect(true);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    wifiConnecting = true;
}

// ─── setup ────────────────────────────────────────────────────────────────────

void setup() {
    Serial.begin(115200);
    delay(1500);

#ifdef NEOPIXEL_POWER
    pinMode(NEOPIXEL_POWER, OUTPUT);
    digitalWrite(NEOPIXEL_POWER, HIGH);
#endif
#ifdef PIN_I2C_POWER
    pinMode(PIN_I2C_POWER, OUTPUT);
    digitalWrite(PIN_I2C_POWER, HIGH);
#endif
    delay(50);

    pixel.begin();
    pixel.setBrightness(30);
    pixel.setPixelColor(0, pixel.Color(5, 5, 0));
    pixel.show();

    Serial.println("\n=== 2x2 OLED Dashboard ===");
    Serial.println("Wire: SDA=3 SCL=4 (all devices)");

    Wire.begin(SDA_PIN, SCL_PIN);   // all devices: TCA, OLEDs, sensors
    delay(100);

    // General Call Reset — unstick any locked devices
    Wire.beginTransmission(0x00);
    Wire.write(0x06);
    Wire.endTransmission();
    delay(50);

    // ── Init all 4 displays ───────────────────────────────────────────────────
    Adafruit_SSD1306* disps[4] = {&disp0, &disp1, &disp2, &disp3};
    for (int ch = 0; ch < 4; ch++) {
        tcaSelect(ch);
        delay(10);
        if (!i2cProbe(OLED_ADDR)) {
            Serial.printf("  CH%d: OLED not found\n", ch);
            tcaDisable(); continue;
        }
        if (!disps[ch]->begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
            Serial.printf("  CH%d: begin() failed\n", ch);
            tcaDisable(); continue;
        }
        if (ch == 0 || ch == 2) disps[ch]->setRotation(2);
        disps[ch]->clearDisplay();
        disps[ch]->display();
        Serial.printf("  CH%d: OK\n", ch);
        tcaDisable();
    }

    // ── Battery gauge ─────────────────────────────────────────────────────────
    batteryOK = maxlipo.begin(&Wire);
    if (batteryOK) {
        maxlipo.quickStart();
        delay(250);
        refreshBattery();
        Serial.printf("MAX17048: OK  %d%%  %.3fV\n", batteryPct, batteryV);
    } else {
        Serial.println("MAX17048: not found");
    }

    // ── Temp/humidity sensor ──────────────────────────────────────────────────
    sht4OK = sht4.begin(&Wire);
    if (sht4OK) {
        sht4.setPrecision(SHT4X_HIGH_PRECISION);
        delay(20);
        refreshSensor();
        Serial.printf("SHT4x: OK  %.1fF  %.0f%%RH\n", lastTempF, lastHumidity);
    } else {
        Serial.println("SHT4x: not found");
    }

    // ── WiFi + NTP ────────────────────────────────────────────────────────────
    configTzTime(TZ_INFO, NTP1, NTP2, NTP3);
    {   // Restore last saved epoch so clock shows immediately on every boot
        Preferences p; p.begin("clock", true);
        time_t saved = (time_t)p.getLong64("epoch", 0);
        p.end();
        if (saved > 1609459200L) {   // sanity: after 2021-01-01
            struct timeval tv = { .tv_sec = saved, .tv_usec = 0 };
            settimeofday(&tv, nullptr);
            timeReady     = true;
            timeFromCache = true;
            Serial.printf("Clock: restored epoch %ld from NVS\n", (long)saved);
        }
    }
    {   // Restore last S&P price from NVS
        Preferences p; p.begin("spx", true);
        float savedPrice = p.getFloat("price", 0.0f);
        time_t savedTime = (time_t)p.getLong64("ftime", 0);
        float savedChPct = p.getFloat("chpct", 0.0f);
        float savedChDol = p.getFloat("chdol", 0.0f);
        p.end();
        if (savedPrice > 100.0f) {
            spxPrice        = savedPrice;
            spxChangePct    = savedChPct;
            spxChangeDollar = savedChDol;
            spxFetchTime  = savedTime;
            spxHasData    = true;
            Serial.printf("SPX: restored %.2f (%.2f%%) from NVS\n", spxPrice, spxChangePct);
        }
    }
    tryWifi();

    pixel.setPixelColor(0, pixel.Color(0, 0, 0));
    pixel.show();

    Serial.println("Setup done.");
}

// ─── loop ─────────────────────────────────────────────────────────────────────

void loop() {
    unsigned long now = millis();

    bool wasConnected = wifiConnected;
    wifiConnected = (WiFi.status() == WL_CONNECTED);
    if (wifiConnected) {
        wifiConnecting = false;
        if (!wasConnected) {
            Serial.printf("WiFi connected: %s\n", WiFi.localIP().toString().c_str());
            spxFetchedAt = 0;  // force immediate SPX fetch on reconnect
        }
        if (!timeReady || timeFromCache) {
            struct tm ti;
            if (getLocalTime(&ti, 50)) {
                timeReady     = true;
                timeFromCache = false;
                time_t ep; time(&ep);
                Preferences p; p.begin("clock", false);
                p.putLong64("epoch", (long long)ep);
                p.end();
                Serial.println("NTP synced — epoch saved to NVS");
            }
        }
    } else {
        if (now - lastWifiRetry > WIFI_RETRY) {
            lastWifiRetry = now;
            tryWifi();
        }
    }

    if (now - lastBattery > BATTERY_MS) { lastBattery = now; refreshBattery(); }
    if (now - lastSensor  > SENSOR_MS)  { lastSensor  = now; refreshSensor();  }
    if (wifiConnected && (spxFetchedAt == 0 || now - spxFetchedAt > (spxHasData ? SPX_FETCH_MS : 30000UL))) {
        spxFetchedAt = now;
        refreshSPX();
    }

    // advance heart animation independently of draw rate
    if (now - lastHeartDraw > HEART_FRAME_MS) {
        lastHeartDraw = now;
        heartFrame = (heartFrame + 1) % HEART_FRAME_COUNT;
    }
    if (now - lastEyeFrame > EYE_FRAME_MS) {
        lastEyeFrame = now;
        eyeFrame = (eyeFrame + 1) % EYE_FRAME_COUNT;
    }
    if (now - lastWalkFrame > WALK_FRAME_MS) {
        lastWalkFrame = now;
        walkFrame = (walkFrame + 1) % WALK_FRAME_COUNT;
        walkX += 2;
        if (walkX > SCREEN_WIDTH + WALK_W / 2) {
            walkX = -WALK_W / 2;
            walkLooped = true;
        }
    }
    if (now - lastFidgetFrame > FIDGET_FRAME_MS) {
        lastFidgetFrame = now;
        fidgetFrame = (fidgetFrame + 1) % FIDGET_FRAME_COUNT;
    }

    // cycle between screen sets (Set B waits for walk to finish crossing)
    if (now - lastSetSwitch > SET_SWITCH_MS && (screenSet != 1 || walkLooped)) {
        lastSetSwitch = now;
        screenSet = (screenSet + 1) % 3;
        walkLooped = false;
        if (screenSet == 1) walkX = -WALK_W / 2;  // restart walk from left
    }

    if (now - lastDraw > DRAW_MS) {
        lastDraw = now;
        if (screenSet == 0) {
            tcaSelect(0); drawCh0();
            tcaSelect(1); drawCh1();
            tcaSelect(2); drawCh2();
            tcaSelect(3); drawCh3();
        } else if (screenSet == 1) {
            tcaSelect(0); drawB_Ch0();
            tcaSelect(1); drawB_Ch1();
            tcaSelect(2); drawB_Ch2();
            tcaSelect(3); drawB_Ch3();
        } else {
            tcaSelect(0); drawC_Ch0();
            tcaSelect(1); drawC_Ch1();
            tcaSelect(2); drawC_Ch2();
            tcaSelect(3); drawC_Ch3();
        }
        tcaDisable();
    }
}
