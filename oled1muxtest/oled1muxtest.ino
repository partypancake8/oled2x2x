// C-CH0 — Rickroll QR code (top-right, FLIPPED)
static void drawC_Ch0() {
    static uint8_t qrBuf[qrcode_getBufferSize(3)];
    static QRCode  qrc;
    static bool    built = false;
    if (!built) {
        qrcode_initText(&qrc, qrBuf, 3, ECC_LOW, "https://youtu.be/dQw4w9WgXcQ");
        built = true;
    }
    disp0.clearDisplay();
    const uint8_t scale = 2;
    int sz   = qrc.size * scale;
    int xOff = (SCREEN_WIDTH  - sz) / 2;
    int yOff = (SCREEN_HEIGHT - sz) / 2;
    for (uint8_t y = 0; y < qrc.size; y++) {
        for (uint8_t x = 0; x < qrc.size; x++) {
            if (qrcode_getModule(&qrc, x, y))
                disp0.fillRect(xOff + x*scale, yOff + y*scale, scale, scale, SSD1306_WHITE);
        }
    }
    disp0.display();
}

