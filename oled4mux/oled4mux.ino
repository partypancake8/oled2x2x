// Sensor / network helpers
// ---------------------------------------------------------------------------

void refreshBattery() {
  if (!batteryOK) return;
  float p = maxlipo.cellPercent(), v = maxlipo.cellVoltage();
  batteryPercent  = isnan(p) ? -1 : constrain((int)(p + 0.5f), 0, 100);
  batteryVoltage  = isnan(v) ? -1.0f : v;
}

void refreshSensor() {
  if (!sht4OK) return;
  sensors_event_t humidity, temp;
  sht4.getEvent(&humidity, &temp);
  lastTempF    = (temp.temperature * 9.0f / 5.0f) + 32.0f;
  lastHumidity = humidity.relative_humidity;
}

bool connectWiFi(unsigned long ms = 15000) {
  wifiConnecting = true; wifiConnected = false; updateStatusLED();
  WiFi.mode(WIFI_STA); WiFi.disconnect(); delay(100);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long t = millis();
  while (millis() - t < ms) {
    if (WiFi.status() == WL_CONNECTED) {
      wifiConnected = true; wifiConnecting = false; updateStatusLED(); return true;
    }
    updateStatusLED(); delay(200);
  }
  wifiConnected = false; wifiConnecting = false; updateStatusLED(); return false;
}

bool syncTimeFromNTP(unsigned long ms = 12000) {
  configTzTime(TZ_INFO, NTP1, NTP2, NTP3);
  struct tm ti;
  unsigned long t = millis();
  while (millis() - t < ms) {
    if (getLocalTime(&ti, 200)) {
      timeReady = true; lastNtpSyncMs = millis(); updateStatusLED(); return true;
    }
    updateStatusLED(); delay(100);
  }
  return false;
}

// ---------------------------------------------------------------------------
// I2C / mux diagnostics  (results appear in Serial Monitor at 115200 baud)
// ---------------------------------------------------------------------------

// Scan the currently-active I2C bus and print every found address.
void i2cScan(const char* label) {
  Serial.printf("--- I2C scan: %s ---\n", label);
  int found = 0;
  for (uint8_t addr = 1; addr < 127; addr++) {
    Wire.beginTransmission(addr);
    if (Wire.endTransmission() == 0) {
      Serial.printf("  0x%02X", addr);
      if (addr == TCA_ADDR)  Serial.print("  <- TCA9548A mux");
      if (addr == OLED_ADDR) Serial.print("  <- SSD1306 OLED");
      if (addr == 0x36)      Serial.print("  <- MAX17048 battery gauge");
      if (addr == 0x44)      Serial.print("  <- SHT4x temp/humidity");
      Serial.println();
      found++;
    }
  }
  if (!found) Serial.println("  (nothing found)");
}

// Check the mux is present then scan each channel for the OLED.
void muxDiag() {
  Serial.println("=== TCA9548A / mux diagnostic ===");

  // 1. Check mux is reachable on main bus
  Wire.beginTransmission(TCA_ADDR);
  uint8_t err = Wire.endTransmission();
  if (err != 0) {
    Serial.printf("  ERROR: TCA9548A NOT found at 0x%02X (err=%d)\n", TCA_ADDR, err);
    Serial.println("  Check: power to breakout, SDA/SCL polarity, A0/A1/A2 all LOW");
    return;
  }
  Serial.printf("  TCA9548A OK at 0x%02X\n", TCA_ADDR);

  // 2. Per-channel OLED check
  for (uint8_t ch = 0; ch < NUM_SCREENS; ch++) {
    tcaSelect(ch);
    delay(5);
    Wire.beginTransmission(OLED_ADDR);
    err = Wire.endTransmission();
    Serial.printf("  SD%d: OLED 0x%02X %s\n",
                  ch, OLED_ADDR, err == 0 ? "OK" : "NOT FOUND (check wires / power)");
  }
  tcaDisable();
  Serial.println("=================================");
}

// Show a boot message on all 4 screens
void showBootMessage(const char* line1, const char* line2) {
  for (uint8_t ch = 0; ch < NUM_SCREENS; ch++) {
    tcaSelect(ch);
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    centerText(line1, 16, 1);
    centerText(line2,  32, 2);
    display.display();
  }
}

// ---------------------------------------------------------------------------
// setup / loop
// ---------------------------------------------------------------------------

void setup() {
  Serial.begin(115200);
  delay(1000);

  enableI2CPower();
  enableNeoPixelPower();
  pixel.begin();
  pixel.setBrightness(LED_BRIGHTNESS);
  setPixel(0, 0, 0);

  Wire.begin(SDA_PIN, SCL_PIN);
  analogReadResolution(12);   // ESP32-S3: ensure full 12-bit ADC range
  pinMode(LDR_PIN, INPUT);

  // Run I2C diagnostics — read results in Serial Monitor
  i2cScan("main bus (before mux)");
  muxDiag();

  // Initialize all 4 displays through the TCA9548A
  for (uint8_t ch = 0; ch < NUM_SCREENS; ch++) {
    tcaSelect(ch);
    if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
      Serial.printf("SSD1306 init failed on channel %d\n", ch);
      // Flash red and keep trying the remaining channels
      setPixel(10, 0, 0); delay(200); setPixel(0, 0, 0);
    } else {
      display.clearDisplay();
      display.display();
      Serial.printf("Screen %d OK\n", ch);
    }
  }
  tcaDisable();

  // Sensors (not behind the mux — on main I2C bus)
  batteryOK = maxlipo.begin(&Wire);
  if (batteryOK) { maxlipo.quickStart(); delay(250); refreshBattery(); }

  sht4OK = sht4.begin(&Wire);
  if (sht4OK) { sht4.setPrecision(SHT4X_HIGH_PRECISION); refreshSensor(); }

  showBootMessage("Connecting", "WiFi...");
  connectWiFi();
  if (wifiConnected) syncTimeFromNTP();

  // First full draw pass
  tcaSelect(0); drawScreen0();
  tcaSelect(1); drawScreen1();
  tcaSelect(2); drawScreen2();
  tcaSelect(3); drawScreen3();
  tcaDisable();

  updateStatusLED();
}

void loop() {
  unsigned long now = millis();

  wifiConnected = (WiFi.status() == WL_CONNECTED);

  if (!wifiConnected && !wifiConnecting && (now - lastReconnectAttempt >= WIFI_RETRY_INTERVAL_MS)) {
    lastReconnectAttempt = now;
    connectWiFi(8000);
    if (wifiConnected) syncTimeFromNTP(5000);
  }

  if (now - lastBatteryRead >= BATTERY_READ_INTERVAL_MS) {
    lastBatteryRead = now;
    refreshBattery();
  }

  if (now - lastSensorRead >= SENSOR_READ_INTERVAL_MS) {
    lastSensorRead = now;
    refreshSensor();
  }

  if (now - lastLdrRead >= LDR_READ_INTERVAL_MS) {
    lastLdrRead = now;
    updateBrightness();
  }

  // ── Light sleep when screens are off ──────────────────────────────────────
  if (currentContrast == 0) {
    if (!screenSleeping) {
      // First time going dark: drop WiFi to save power
      WiFi.disconnect(true);
      WiFi.mode(WIFI_OFF);
      wifiConnected = false;
      screenSleeping = true;
    }
    esp_sleep_enable_timer_wakeup(LDR_SLEEP_DURATION_US);
    esp_light_sleep_start();
    // Execution resumes here after timer wakeup.
    // Loop again immediately so updateBrightness() re-reads LDR.
    return;
  } else if (screenSleeping) {
    // Just came back from dark period — re-enable WiFi
    screenSleeping = false;
    WiFi.mode(WIFI_STA);
    lastReconnectAttempt = 0; // force immediate reconnect attempt
  }
  // ─────────────────────────────────────────────────────────────────────────

  if (wifiConnected && (!timeReady || (now - lastNtpSyncMs >= NTP_RESYNC_INTERVAL_MS))) {
    syncTimeFromNTP(5000);
  }

  if (now - lastDrawMs >= DRAW_INTERVAL_MS) {
    lastDrawMs = now;
    tcaSelect(0); drawScreen0();
    tcaSelect(1); drawScreen1();
    tcaSelect(2); drawScreen2();
    tcaSelect(3); drawScreen3();
    tcaDisable();
  }

  updateStatusLED();
  delay(10);
}
