// Screen 0 (SD0): Animated heart GIF
void drawScreen0() {
  display.clearDisplay();
  drawHeader(false);
  if (isLowBattery()) {
    display.setTextColor(SSD1306_WHITE);
    centerText("LOW",    22, 2);
    centerText("BATTERY",40, 2);
    if (batteryPercent >= 0) centerText(String(batteryPercent) + "%", 56, 1);
  } else {
    display.drawBitmap(40, HEADER_H, frames[heartFrame], FRAME_WIDTH, FRAME_HEIGHT, SSD1306_WHITE);
    heartFrame = (heartFrame + 1) % FRAME_COUNT;
  }
  display.display();
}

// Screen 1 (SD1): Clock
void drawScreen1() {
  display.clearDisplay();
  drawHeader(true);
  display.setTextColor(SSD1306_WHITE);
  if (!timeReady) {
    centerText("No time", 32, 1);
  } else {
    struct tm ti;
    if (!getLocalTime(&ti, 20)) {
      centerText("No time", 32, 1);
    } else {
      char hm[6]; strftime(hm, sizeof(hm), "%I:%M", &ti);
      if (hm[0] == '0') memmove(hm, hm + 1, sizeof(hm) - 1);
      char sec[3];  strftime(sec,  sizeof(sec),  "%S",  &ti);
      char ampm[3]; strftime(ampm, sizeof(ampm), "%p",  &ti);

      int16_t x1, y1; uint16_t w, h;
      display.setTextSize(3);
      display.getTextBounds(hm, 0, 0, &x1, &y1, &w, &h);
      display.setCursor((SCREEN_WIDTH - (int)w) / 2, 19);
      display.print(hm);

      char sub[8]; snprintf(sub, sizeof(sub), ":%s %s", sec, ampm);
      display.setTextSize(1);
      display.getTextBounds(sub, 0, 0, &x1, &y1, &w, &h);
      display.setCursor((SCREEN_WIDTH - (int)w) / 2, 46);
      display.print(sub);

      // date line
      char datebuf[16]; strftime(datebuf, sizeof(datebuf), "%a %b %d", &ti);
      display.getTextBounds(datebuf, 0, 0, &x1, &y1, &w, &h);
      display.setCursor((SCREEN_WIDTH - (int)w) / 2, 56);
      display.print(datebuf);
    }
  }
  display.display();
}

// Screen 2 (SD2): Temperature & Humidity
void drawScreen2() {
  display.clearDisplay();
